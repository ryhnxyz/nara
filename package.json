{
  "name": "nara-bot-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:init": "pnpm --filter @nara-bot/db db:init",
    "daemon": "pnpm --filter @nara-bot/daemon dev",
    "web": "pnpm --filter @nara-bot/web dev"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
